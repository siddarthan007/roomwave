/*
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Hashed build assets are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The SPA shell must revalidate so a new deploy is picked up immediately;
# hashed /assets carry the actual content, so this stays cheap.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/emoji/*
  Cache-Control: public, max-age=31536000, immutable

/mark.svg
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# Never cache the realtime surfaces. Cloudflare's default "Cache Everything"
# or tiered cache can otherwise serve stale room state and buffer SSE streams.
/api/rooms/*/events
  Cache-Control: no-store, no-transform
  CF-Cache-Status: BYPASS

/api/*
  Cache-Control: no-store
  CF-Cache-Status: BYPASS
