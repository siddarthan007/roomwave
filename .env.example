PORT=3000
ROOMWAVE_DB_PATH=apps/api/data/roomwave.sqlite
# Comma-separated socket peer IPs for proxies that append X-Forwarded-For.
ROOMWAVE_TRUSTED_PROXY_IPS=
# Exact comma-separated frontend origins allowed to call the API.
ROOMWAVE_ALLOWED_ORIGINS=http://localhost:5173,http://172.16.40.100:5173
# Set to 1 only for a production Bun build that should serve apps/web/dist.
ROOMWAVE_SERVE_WEB=0
VITE_PUBLIC_URL=http://localhost:5173
# Leave blank for same-origin. Set to the Bun API origin for Vercel/Pages frontend hosting.
VITE_API_URL=
